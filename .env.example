# Sanity — find these at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Shared secret for the Sanity publish webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Canonical origin, used for sitemap.xml and robots.txt.
# Leave unset on Vercel until a custom domain is attached.
NEXT_PUBLIC_SITE_URL=
